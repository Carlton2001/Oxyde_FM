    pub fn start_selection_drag(&mut self, pane_id: String, start_pos: Point<Pixels>, modifiers: Modifiers, cx: &mut Context<Self>) {
        let initial_selection = self.state.find_pane(&pane_id).map(|p| p.active_tab().selected_paths.clone()).unwrap_or_default();
        
        if !modifiers.control && !modifiers.shift {
            if let Some(pane) = self.state.find_pane_mut(&pane_id) {
                let tab = pane.active_tab_mut();
                tab.selected_paths.clear();
                tab.selection_anchor = None;
            }
        }

        self.drag_target = Some(DragTarget::SelectionRectangle {
            pane_id: pane_id.clone(),
            start_pos,
            current_pos: start_pos,
            modifiers,
            initial_selection,
        });
        
        let handle = cx.entity().clone();
        cx.spawn(|_this, mut cx| async move {
            loop {
                let mut should_continue = false;
                let mut p_id = String::new();
                let mut pos = Point::default();
                
                let updated = handle.update(&mut cx, |this: &mut OxydeApp, _| {
                    if let Some(DragTarget::SelectionRectangle { pane_id, current_pos, .. }) = &this.drag_target {
                        should_continue = true;
                        p_id = pane_id.clone();
                        pos = *current_pos;
                    }
                });
                
                if updated.is_err() || !should_continue { break; }
                
                let _ = handle.update(&mut cx, |this: &mut OxydeApp, cx| {
                    this.handle_selection_drag(p_id, pos, cx);
                });
                
                cx.background_executor().timer(std::time::Duration::from_millis(16)).await;
            }
        }).detach();
    }